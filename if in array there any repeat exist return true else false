  //if in array there any repeat exist return true else false
  import java.util.*;

 public class JavaBasics{

public static boolean checkfordouble(int nums[]){
  for(int i=0;i<=nums.length-1;i++){
    for(int j=i+1;j<=nums.length-1;j++){
      if(nums[i]==nums[j]){
        return true;
      }
    }
  }
  return false;
}
     public static void main(String[] args){
      
      int nums[]={1,2,3,4,5,1};
     
     System.out.println(checkfordouble(nums));
  }
}
