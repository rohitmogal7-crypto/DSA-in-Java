  //sum of numbers in an array
  import java.util.*;

 public class JavaBasics{
  public static int sumofnums(int nums[]){
    int sum = 0;
    for(int i=0;i<nums.length;i++){
      sum+=nums[i];
    }
    return sum;
  }
     public static void main(String[] args){
      int nums[] = {90,80,10,20,50,75};
      int result = sumofnums(nums);
      System.out.println("Sum of numbers in the array: " + result);
    }
 }
