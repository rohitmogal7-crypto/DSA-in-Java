  //count occurance of an element in an array methond second
  import java.util.*;

 public class JavaBasics{
  public static int find_second_largest(int nums[]){
    int largest=nums[0];
    int second_largest=nums[1];
    for(int i=0;i<nums.length;i++){
      if(largest<nums[i]){
        largest=nums[i];
      }
    else if(nums[i] > second_largest && nums[i] != largest){
        second_largest=nums[i];
      }      
    }
   
    return second_largest;
  }
     public static void main(String[] args){
      int nums[] = {90,80,10,20,50,75};
      
      int result = find_second_largest(nums);
      System.out.println("Second largest element in the array: " + result);
    }
 }
